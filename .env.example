# Copy to .env (gitignored) and edit. bin/setup writes one for you.
#
# These are DEVELOPMENT knobs only. Production secrets are declared in .env.tpl
# and fetched from Secrets Manager at deploy time -- nothing here reaches the
# server.

# Names the database on the shared MySQL server, which holds every project's.
# Set once, at setup.
APP_NAME=app

# Host port. A second checkout -- a worktree, a review copy -- runs its own
# stack beside this one; compose namespaces containers by directory, so this
# binding is the only thing that would collide.
HTTP_PORT=8282

# The shared Redis in ../dev-infra. Only read if the app caches in Redis; a
# stock Rails 8 app uses solid_cache in the database and ignores it.
# REDIS_HOST=dev-redis
